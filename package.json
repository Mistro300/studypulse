{
  "name": "studypulse",
  "version": "0.1.0",
  "private": true,
  "description": "StudyPulse — Offline-First Smart Study & Live Timed Assessment PWA",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @studypulse/web dev",
    "dev:api": "pnpm --filter @studypulse/api dev",
    "build": "pnpm --filter @studypulse/shared build && pnpm --filter @studypulse/api build && pnpm --filter @studypulse/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "test": "pnpm --filter @studypulse/shared test && pnpm --filter @studypulse/api test",
    "prisma:validate": "pnpm --filter @studypulse/api prisma:validate",
    "prisma:generate": "pnpm --filter @studypulse/api prisma:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  }
}
