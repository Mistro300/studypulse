# Database & Cache
DATABASE_URL="postgresql://studypulse:studypulse@localhost:5432/studypulse?schema=public"
REDIS_URL="redis://localhost:6379"

# API Server
API_PORT=4000
API_HOST="0.0.0.0"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# JWT & Auth
JWT_ACCESS_SECRET="replace-with-at-least-32-chars-access-secret"
JWT_REFRESH_SECRET="replace-with-at-least-32-chars-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Optional External Question Sources
LLM_API_KEY=""
LLM_API_BASE_URL=""

# Optional Web Push (VAPID)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@studypulse.app"

# Frontend (Vite)
VITE_API_URL="http://localhost:4000"
VITE_WS_URL="http://localhost:4000"
VITE_VAPID_PUBLIC_KEY=""
VITE_SENTRY_DSN=""
